# =====================================================================
# FarmiQ Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in the values.
# NEVER commit your real .env.local with credentials to Git!
# =====================================================================

# TiDB Cloud or MySQL 8 connection string with TLS:
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict
DATABASE_URL=""

# Secret string used to sign sessions and cookies (e.g. generate with: openssl rand -base64 32)
SESSION_SECRET=""

# Vercel Blob token for storing crop photos and marketplace listing photos
BLOB_READ_WRITE_TOKEN=""

# Google Gemini API key for crop disease scan and farming chatbot
GEMINI_API_KEY=""

# data.gov.in API key for Mandi market prices
DATA_GOV_API_KEY=""

# Web Push notification keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@farmiq.app"

# Secret key to secure daily Vercel cron endpoints
CRON_SECRET=""
