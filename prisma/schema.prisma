// Prisma Schema for FarmiQ (MySQL 8 / TiDB Cloud compatible)
// Based on farmiq_schema.sql - do not change tables without user approval.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Language {
  en
  ta
  te
}

enum Theme {
  system
  light
  dark
}

enum CropStatus {
  active
  harvested
  failed
}

enum CropHealth {
  good
  average
  poor
}

enum ConfidenceLevel {
  low
  medium
  high
}

enum InventoryCategory {
  seed
  fertilizer
  pesticide
  tool
  produce
  other
}

enum ActivityType {
  sowing
  watering
  fertilizer
  pesticide
  weeding
  labour
  harvest
  other
}

enum MovementReason {
  purchase
  used
  harvest
  sold
  adjustment
}

enum TransactionType {
  income
  expense
}

enum TaskStatus {
  pending
  done
}

enum TaskSource {
  manual
  chatbot
  template
  damage_report
}

enum ChatRole {
  user
  assistant
}

enum NotificationType {
  task
  weather
  stock
  price
  listing
  system
}

enum WeatherAlertType {
  rain
  heat
  wind
  other
}

enum ListingStatus {
  active
  sold
  expired
  removed
}

enum ReportStatus {
  open
  reviewed
}

model User {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  phone         String    @unique(map: "uq_users_phone") @db.VarChar(20)
  name          String    @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  district      String?   @db.VarChar(100)
  language      Language  @default(en)
  theme         Theme     @default(system)
  isAdmin       Boolean   @default(false) @map("is_admin")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamp(0)

  sessions            Session[]
  farms               Farm[]
  damageReports       DamageReport[]
  inventoryItems      InventoryItem[]
  activities          Activity[]
  transactions        Transaction[]
  tasks               Task[]             @relation("UserTasks")
  confirmedTasks      Task[]             @relation("UserConfirmedTasks")
  chatMessages        ChatMessage[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  listings            Listing[]
  listingReports      ListingReport[]

  @@map("users")
}

model Session {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  tokenHash String   @unique(map: "uq_sessions_token") @map("token_hash") @db.Char(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_sessions_user")
  @@map("sessions")
}

model Farm {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  location  String?  @db.VarChar(255)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  areaAcres Decimal? @map("area_acres") @db.Decimal(8, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plots         Plot[]
  weatherAlerts WeatherAlert[]

  @@index([userId], map: "ix_farms_user")
  @@map("farms")
}

model Plot {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  farmId     BigInt   @map("farm_id") @db.UnsignedBigInt
  name       String   @db.VarChar(100)
  areaAcres  Decimal? @map("area_acres") @db.Decimal(8, 2)
  soilType   String?  @map("soil_type") @db.VarChar(50)
  irrigation String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  farm       Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crops      Crop[]
  activities Activity[]

  @@index([farmId], map: "ix_plots_farm")
  @@map("plots")
}

model CropMaster {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  nameEn       String  @unique(map: "uq_crop_master_name") @map("name_en") @db.VarChar(100)
  nameTa       String? @map("name_ta") @db.VarChar(100)
  nameTe       String? @map("name_te") @db.VarChar(100)
  durationDays Int     @map("duration_days") @db.UnsignedInt
  stages       Json?
  taskTemplate Json?   @map("task_template")

  crops Crop[]

  @@map("crop_master")
}

model Crop {
  id                 BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  plotId             BigInt     @map("plot_id") @db.UnsignedBigInt
  cropMasterId       Int?       @map("crop_master_id") @db.UnsignedInt
  cropName           String     @map("crop_name") @db.VarChar(100)
  variety            String?    @db.VarChar(100)
  sowingDate         DateTime   @map("sowing_date") @db.Date
  expectedHarvestDate DateTime? @map("expected_harvest_date") @db.Date
  actualHarvestDate   DateTime? @map("actual_harvest_date") @db.Date
  currentStage       String?    @map("current_stage") @db.VarChar(50)
  stageIndex         Int        @default(1) @map("stage_index") @db.UnsignedTinyInt
  stageTotal         Int        @default(5) @map("stage_total") @db.UnsignedTinyInt
  status             CropStatus @default(active)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  plot          Plot           @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropMaster    CropMaster?    @relation(fields: [cropMasterId], references: [id], onDelete: SetNull)
  cropCheckins  CropCheckin[]
  damageReports DamageReport[]
  activities    Activity[]
  transactions  Transaction[]
  tasks         Task[]

  @@index([plotId], map: "ix_crops_plot")
  @@map("crops")
}

model CropCheckin {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  cropId      BigInt     @map("crop_id") @db.UnsignedBigInt
  checkedOn   DateTime   @map("checked_on") @db.Date
  growthStage String?    @map("growth_stage") @db.VarChar(50)
  health      CropHealth @default(good)
  notes       String?    @db.Text
  photoUrl    String?    @map("photo_url") @db.VarChar(500)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId, checkedOn], map: "ix_checkins_crop")
  @@map("crop_checkins")
}

model DamageReport {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt           @map("user_id") @db.UnsignedBigInt
  cropId           BigInt?          @map("crop_id") @db.UnsignedBigInt
  photoUrl         String           @map("photo_url") @db.VarChar(500)
  detectedIssue    String?          @map("detected_issue") @db.VarChar(200)
  confidence       ConfidenceLevel?
  description      String?          @db.Text
  naturalTreatment String?          @map("natural_treatment") @db.Text
  chemicalAdvice   String?          @map("chemical_advice") @db.Text
  safetyNote       String?          @map("safety_note") @db.Text
  language         Language         @default(en)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(0)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "ix_damage_user")
  @@map("damage_reports")
}

model InventoryItem {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt            @map("user_id") @db.UnsignedBigInt
  name          String            @db.VarChar(100)
  category      InventoryCategory @default(other)
  quantity      Decimal           @default(0) @db.Decimal(10, 2)
  unit          String            @db.VarChar(20)
  costPerUnit   Decimal?          @map("cost_per_unit") @db.Decimal(10, 2)
  lowStockLevel Decimal           @default(0) @map("low_stock_level") @db.Decimal(10, 2)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities         Activity[]
  inventoryMovements InventoryMovement[]

  @@index([userId], map: "ix_inventory_user")
  @@map("inventory_items")
}

model Activity {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt       @map("user_id") @db.UnsignedBigInt
  cropId          BigInt?      @map("crop_id") @db.UnsignedBigInt
  plotId          BigInt?      @map("plot_id") @db.UnsignedBigInt
  activityDate    DateTime     @map("activity_date") @db.Date
  type            ActivityType
  notes           String?      @db.Text
  cost            Decimal?     @db.Decimal(10, 2)
  inventoryItemId BigInt?      @map("inventory_item_id") @db.UnsignedBigInt
  quantityUsed    Decimal?     @map("quantity_used") @db.Decimal(10, 2)
  photoUrl        String?      @map("photo_url") @db.VarChar(500)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop          Crop?               @relation(fields: [cropId], references: [id], onDelete: SetNull)
  plot          Plot?               @relation(fields: [plotId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]

  @@index([userId, activityDate], map: "ix_activities_user")
  @@index([cropId], map: "ix_activities_crop")
  @@map("activities")
}

model InventoryMovement {
  id         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  itemId     BigInt         @map("item_id") @db.UnsignedBigInt
  changeQty  Decimal        @map("change_qty") @db.Decimal(10, 2)
  reason     MovementReason
  activityId BigInt?        @map("activity_id") @db.UnsignedBigInt
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamp(0)

  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  activity Activity?     @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt], map: "ix_movements_item")
  @@map("inventory_movements")
}

model Transaction {
  id        BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt          @map("user_id") @db.UnsignedBigInt
  cropId    BigInt?         @map("crop_id") @db.UnsignedBigInt
  type      TransactionType
  category  String?         @db.VarChar(50)
  amount    Decimal         @db.Decimal(12, 2)
  txnDate   DateTime        @map("txn_date") @db.Date
  notes     String?         @db.VarChar(255)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamp(0)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, txnDate], map: "ix_txn_user")
  @@index([cropId], map: "ix_txn_crop")
  @@map("transactions")
}

model Task {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt     @map("user_id") @db.UnsignedBigInt
  cropId      BigInt?    @map("crop_id") @db.UnsignedBigInt
  title       String     @db.VarChar(200)
  dueDate     DateTime   @map("due_date") @db.Date
  remindAt    DateTime?  @map("remind_at") @db.DateTime(0)
  status      TaskStatus @default(pending)
  completedAt DateTime?  @map("completed_at") @db.DateTime(0)
  confirmedBy BigInt?    @map("confirmed_by") @db.UnsignedBigInt
  source      TaskSource @default(manual)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  user          User          @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  crop          Crop?         @relation(fields: [cropId], references: [id], onDelete: SetNull)
  confirmer     User?         @relation("UserConfirmedTasks", fields: [confirmedBy], references: [id], onDelete: SetNull)
  chatMessages  ChatMessage[]

  @@index([userId, status, dueDate], map: "ix_tasks_user")
  @@index([cropId], map: "ix_tasks_crop")
  @@map("tasks")
}

model ChatMessage {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  role           ChatRole
  content        String    @db.Text
  language       Language  @default(en)
  proposedTaskId BigInt?   @map("proposed_task_id") @db.UnsignedBigInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposedTask Task? @relation(fields: [proposedTaskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "ix_chat_user")
  @@map("chat_messages")
}

model Notification {
  id        BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt           @map("user_id") @db.UnsignedBigInt
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.VarChar(255)
  link      String?          @db.VarChar(255)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt], map: "ix_notif_user")
  @@map("notifications")
}

model PushSubscription {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  endpoint  String   @unique(map: "uq_push_endpoint") @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  authKey   String   @map("auth_key") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_push_user")
  @@map("push_subscriptions")
}

model WeatherAlert {
  id        BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  farmId    BigInt           @map("farm_id") @db.UnsignedBigInt
  alertType WeatherAlertType @map("alert_type")
  alertDate DateTime         @map("alert_date") @db.Date
  message   String           @db.VarChar(255)
  sent      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(0)

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, alertDate], map: "ix_weather_farm")
  @@map("weather_alerts")
}

model MarketPrice {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cropName         String   @map("crop_name") @db.VarChar(100)
  marketName       String   @map("market_name") @db.VarChar(150)
  district         String?  @db.VarChar(100)
  pricePerQuintal  Decimal  @map("price_per_quintal") @db.Decimal(10, 2)
  priceDate        DateTime @map("price_date") @db.Date
  source           String?  @db.VarChar(100)

  @@unique([cropName, marketName, priceDate], map: "uq_price_day")
  @@index([cropName, district, priceDate], map: "ix_price_lookup")
  @@map("market_prices")
}

model Listing {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  sellerId     BigInt        @map("seller_id") @db.UnsignedBigInt
  cropName     String        @map("crop_name") @db.VarChar(100)
  quantity     Decimal       @db.Decimal(10, 2)
  unit         String        @default("kg") @db.VarChar(20)
  pricePerUnit Decimal       @map("price_per_unit") @db.Decimal(10, 2)
  location     String?       @db.VarChar(150)
  photoUrl     String?       @map("photo_url") @db.VarChar(500)
  showPhone    Boolean       @default(false) @map("show_phone")
  status       ListingStatus @default(active)
  expiresAt    DateTime?     @map("expires_at") @db.DateTime(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)

  seller  User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reports ListingReport[]

  @@index([status, cropName, createdAt], map: "ix_listings_browse")
  @@index([sellerId], map: "ix_listings_seller")
  @@map("listings")
}

model ListingReport {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  listingId   BigInt       @map("listing_id") @db.UnsignedBigInt
  reporterId  BigInt       @map("reporter_id") @db.UnsignedBigInt
  reason      String?      @db.VarChar(255)
  status      ReportStatus @default(open)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId], map: "ix_reports_listing")
  @@map("listing_reports")
}
